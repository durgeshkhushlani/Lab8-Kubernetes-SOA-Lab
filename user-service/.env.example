PORT=3001

# Inside Docker/Compose: mongodb://user-db:27017/user_service ("user-db" is the Mongo container's
# service name on the shared network - never localhost/127.0.0.1 from inside a container).
# Running this service directly on your machine (no Docker): mongodb://localhost:27017/user_service
MONGODB_URI=mongodb://user-db:27017/user_service
